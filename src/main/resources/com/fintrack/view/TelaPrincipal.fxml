<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="550.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fintrack.controller.TelaPrincipalController">

   <top>
      <VBox spacing="10.0" styleClass="topo">
         <children>
            <Label styleClass="titulo" text="FinTrack" />
            <HBox spacing="30.0">
               <children>
                  <Label fx:id="lblReceitas" styleClass="receita" text="Receitas: R$ 0,00" />
                  <Label fx:id="lblDespesas" styleClass="despesa" text="Despesas: R$ 0,00" />
                  <Label fx:id="lblSaldo" styleClass="saldo" text="Saldo: R$ 0,00" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </VBox>
   </top>

   <center>
      <VBox spacing="10.0">
         <children>
            <HBox spacing="10.0">
               <children>
                  <TextField fx:id="txtBusca" prefWidth="300.0" promptText="Buscar pela descricao" />
                  <Button fx:id="btnBuscar" text="Buscar" />
                  <Button fx:id="btnLimpar" text="Mostrar todas" />
               </children>
            </HBox>
            <TableView fx:id="tabela" prefHeight="350.0">
              <columns>
                <TableColumn fx:id="colData" prefWidth="100.0" text="Data" />
                <TableColumn fx:id="colDescricao" prefWidth="260.0" text="Descricao" />
                <TableColumn fx:id="colValor" prefWidth="120.0" text="Valor" />
                <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo" />
                <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoria" />
              </columns>
            </TableView>
         </children>
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
         </padding>
      </VBox>
   </center>

   <bottom>
      <HBox spacing="10.0">
         <children>
            <Button fx:id="btnNova" styleClass="botao-principal" text="Nova Transacao" />
            <Button fx:id="btnEditar" text="Editar" />
            <Button fx:id="btnRemover" text="Remover" />
            <Button fx:id="btnRelatorio" text="Relatorio" />
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="5.0" />
         </padding>
      </HBox>
   </bottom>

</BorderPane>
