<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="380.0" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fintrack.controller.TelaRelatorioController">

   <children>
      <Label styleClass="subtitulo" text="Relatorio" />

      <Label fx:id="lblQuantidade" text="Transacoes: 0" />
      <Label fx:id="lblReceitas" styleClass="receita" text="Receitas: R$ 0,00" />
      <Label fx:id="lblDespesas" styleClass="despesa" text="Despesas: R$ 0,00" />
      <Label fx:id="lblSaldo" styleClass="saldo" text="Saldo: R$ 0,00" />

      <Label text="Despesas por categoria:" />
      <TextArea fx:id="txtCategorias" editable="false" prefHeight="150.0" />

      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button fx:id="btnFechar" text="Fechar" />
         </children>
      </HBox>
   </children>

   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

</VBox>
